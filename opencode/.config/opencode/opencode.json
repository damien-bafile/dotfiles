{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "model": "opencode/deepseek-v4-flash-free",
  "lsp": true,
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-20562522-a045-4340-a51b-308d82976187"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ]
    },
    "mcp-mermaid": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-mermaid"
      ]
    },
    "drawio": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@drawio/mcp"
      ]
    },
    "unityMCP": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uvx",
        "--from",
        "mcpforunityserver==9.6.8",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "pdf-reader": {
      "type": "local",
      "command": [
        "npx",
        "@sylphx/pdf-reader-mcp"
      ]
    },
    "kicad-mcp": {
      "type": "local",
      "command": [
        "kicad-mcp-server"
      ]
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "variants": {
            "max": {
              "reasoningEffort": "high",
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            }
          }
        }
      }
    }
  }
}